# ==========================================
# Is My Coco Losing Hair?? (Coconut Hair Counter)
# Configuration Environment Variables
# ==========================================

# Database Configuration (PostgreSQL in production/Docker, SQLite fallback available)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coconut_counter
DATABASE_SQLITE_FALLBACK=sqlite:///./coconut_counter.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10

# Image Storage Options: local, s3, cloudinary
STORE_ANALYSIS_IMAGES=false
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=uploads

# AWS S3 (Optional - needed only if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Cloudinary (Optional - needed only if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Computer Vision Algorithm
ALGORITHM_VERSION=1.0.0
CONFIDENCE_HIGH_THRESHOLD=75.0
CONFIDENCE_MEDIUM_THRESHOLD=50.0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
